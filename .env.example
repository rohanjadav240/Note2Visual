# Note2Visual Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=sqlite:///./note2visual.db

# AI Provider (openai, anthropic, google, or demo)
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=

# OpenAI specific
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic specific  
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google specific
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret key for session/token signing
SECRET_KEY=change-this-to-a-random-secret-key
